# OpenAlex API Key (get free at https://openalex.org/settings/api)
OPENALEX_API_KEY=your-api-key-here

# Recommended: contact email for OpenAlex polite pool and Crossref requests.
# Not strictly required, but improves rate limits and provider contactability.
OPENALEX_EMAIL=you@example.org

# ZhipuAI Embedding API Key (https://bigmodel.cn)
# 可选：仅当需要使用语义检索 (Embedding-3) 时设置；不设置则 SQL 查询正常可用
ZHIPUAI_API_KEY=your-zhipuai-key-here

# Elsevier API Key (for Abstract Retrieval API and Scopus Search fallback)
# 可选：用于自动回填缺摘要的 Elsevier/Scopus 文献，或手动 fetch_elsevier_abstracts
ELSEVIER_API_KEY=your-elsevier-api-key-here

# Optional Elsevier institutional token, if your institution requires one
ELSEVIER_INST_TOKEN=your-elsevier-inst-token-here

# Automatic abstract backfill before search results enter the library.
# Every work is retained even when all backfill sources fail.
BACKFILL_ABSTRACTS=true
# If missing-abstract works exceed this number, prioritize the top-cited
# Elsevier-journal works up to this count instead of backfilling the whole
# batch. 0 disables the cap (no limiting).
BACKFILL_MAX_TARGETS=25
# Number of DOI backfill pipelines running concurrently.
BACKFILL_CONCURRENCY=4
